# Copy to .env.pilot; keep credentials local. No fixture records are seeded in this instance.
AI_MODE=real
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
DEMO_PASSWORD=CatalogForge-pilot-local-2026!
AI_MAX_INPUT_TOKENS=32000
AI_MAX_OUTPUT_TOKENS=2048
AI_PROVIDER_RETRIES=1
AI_CALL_TIMEOUT_SECONDS=40
AI_SCOPE_MAX_CALLS=200
AI_SCOPE_MAX_TOKENS=500000
AI_WORKSPACE_MAX_CALLS=1000
AI_WORKSPACE_MAX_TOKENS=2000000
