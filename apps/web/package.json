{
  "name": "catalogforge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5288",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "generate:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "prebuild": "node scripts/pdf-assets.mjs",
    "postinstall": "node scripts/pdf-assets.mjs",
    "predev": "node scripts/pdf-assets.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.46.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/vue-query": "^5.90.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pdfjs-dist": "6.3.289",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.12.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.2.0"
  }
}
