  "category": {
    "name": "Work gloves \u00b7 adversarial evaluation",
    "identity_fields": [
      "manufacturer",
      "model"
    ],
    "attributes": [
      {
        "key": "material",
        "label": "Liner materials",
        "type": "string",
        "description": "Material composition explicitly listed under Materials; preserve all listed components. Exclude the separate dipping/coating field."
      },
      {
        "key": "inner_pack_count",
        "label": "Declared inner pack count",
        "type": "number",
        "minimum": 0,
        "description": "Number explicitly labeled Inner Pack. Do not interpret as pairs, pieces or boxes beyond what the source states."
      },
      {
        "key": "outer_carton_count",
        "label": "Declared outer carton count",
        "type": "number",
        "minimum": 0,
        "description": "Number explicitly labeled Outer Carton. Do not substitute dimensions or convert between packaging levels."
      },
      {
        "key": "gauge",
        "label": "Liner gauge",
        "type": "number",
        "minimum": 1,
        "description": "Explicit gauge of the glove liner; do not infer from product code or a name without a gauge label."
      },
      {
        "key": "length_mm",
        "label": "Finished glove length",
        "type": "number",
        "unit": "mm",
        "minimum": 1,
        "description": "Length of the glove itself only. Never use carton Len/Wid/Hgt, weight, commodity code or standard numbers."
      }
    ]
  },
